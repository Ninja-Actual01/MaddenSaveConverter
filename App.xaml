<Application x:Class="MaddenSaveConverter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Legion of Loom brand palette: deep black + vivid green -->
        <SolidColorBrush x:Key="BgBrush" Color="#060806"/>
        <SolidColorBrush x:Key="BgBrushDeep" Color="#030503"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#0D120D"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#173A22"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00E25E"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="#00A84C"/>
        <SolidColorBrush x:Key="AccentGlowBrush" Color="#0AFF6E"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#0C3A1E"/>
        <SolidColorBrush x:Key="TextBrush" Color="#ECF5EE"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7C8C80"/>
        <SolidColorBrush x:Key="GridLineBrush" Color="#173A22"/>

        <!-- ===================== Window ===================== -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <!-- ===================== Button ===================== -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0B1410"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0E2A19"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentGlowBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#07A849"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#04130A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== TextBox ===================== -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#070C08"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===================== CheckBox ===================== -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <Border x:Name="box" Width="18" Height="18" CornerRadius="3"
                                    Background="#070C08" BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock x:Name="mark" Text="✓" Foreground="{StaticResource AccentBrush}"
                                           FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="0,-1,0,0" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
                                <Setter TargetName="box" Property="Background" Value="#0E2A19"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== TabControl / TabItem ===================== -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Margin="2,0" CornerRadius="4,4,0,0"
                                Background="{StaticResource BgBrushDeep}"
                                BorderThickness="1,1,1,0" BorderBrush="{StaticResource PanelBorderBrush}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" Margin="20,10"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PanelBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== ScrollBar (thin green) ===================== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
        </Style>
    </Application.Resources>
</Application>
