<Window x:Class="MaddenSaveConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="Madden Save Converter" Height="700" Width="900"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- banner -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Madden Save Converter" FontSize="28" FontWeight="Bold" FontFamily="Segoe UI Black"
                       Foreground="{StaticResource AccentGlowBrush}"/>
            <TextBlock Text="roster and franchise save conversion"
                       FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="2,4,0,0"/>
        </StackPanel>

        <!-- accent divider -->
        <Border Grid.Row="1" Height="2" CornerRadius="1" Margin="0,0,0,16"
                Background="{StaticResource AccentDarkBrush}"/>

        <TabControl Grid.Row="2">
            <TabItem Header="CONVERT">
        <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- source/output pickers -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="14">
            <StackPanel>
                <TextBlock FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8">
                    <Run Text="▪ "/><Run Text="SOURCE SAVE FILE(S)"/></TextBlock>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SourcePathBox" Grid.Column="0" IsReadOnly="True"
                             TextChanged="SourcePath_TextChanged" VerticalContentAlignment="Center"
                             ToolTip="Select one or more save files to convert"/>
                    <Button x:Name="BrowseBtn" Grid.Column="1" Content="Browse…" Margin="10,0,0,0" Click="Browse_Click"/>
                </Grid>

                <TextBlock FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,12,0,8">
                    <Run Text="▪ "/><Run Text="OUTPUT FOLDER (OPTIONAL)"/></TextBlock>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputDirBox" Grid.Column="0" VerticalContentAlignment="Center"
                             TextChanged="OutputDir_TextChanged" ToolTip="Leave blank to use the default saves folder for each file"/>
                    <Button Grid.Column="1" Content="Browse…" Margin="10,0,0,0" Click="BrowseOutput_Click"/>
                    <Button Grid.Column="2" Content="Use Default" Margin="8,0,0,0" Click="ClearOutput_Click"/>
                </Grid>

                <Border x:Name="DetectPanel" Background="#00C04814" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DetectIcon" Text="▶" Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock x:Name="DetectText" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- convert -->
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0"
                           Text="Draft class options (when converting CAREERDRAFT files):"/>
                <CheckBox x:Name="KeepDraftPortraitIdsCheck" Content="Keep source portrait IDs" IsChecked="True"
                          Foreground="{StaticResource TextBrush}" Margin="0,0,14,0"
                          ToolTip="Checked (default): preserve portrait/appearance data from the source draft class. Unchecked: use target Madden template matches and generic/template portraits for players not found in the target template."/>
                <CheckBox x:Name="KeepDraftAssetNamesCheck" Content="Keep source asset names" IsChecked="True"
                          Foreground="{StaticResource TextBrush}"
                          ToolTip="Checked (default): preserve asset names/cyberface IDs from the source draft class. Unchecked: use target Madden template matches and generic/template asset names for players not found in the target template."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="ConvertBtn" Content="CONVERT" Padding="28,9" Click="Convert_Click" IsEnabled="False"/>
                <TextBlock x:Name="OutputNote" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="520"/>
            </StackPanel>
        </StackPanel>

        <!-- log -->
        <Border Grid.Row="3" Background="#060606" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="4" Margin="0,14,0,0">
            <TextBox x:Name="LogBox" Background="Transparent" Foreground="#9FE0B4"
                     FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0" Padding="8"/>
        </Border>
    </Grid>
            </TabItem>
            <TabItem Header="FRANCHISE STUDIO">
        <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><!-- source -->
                <RowDefinition Height="Auto"/><!-- status -->
                <RowDefinition Height="*"/><!-- teams / season -->
                <RowDefinition Height="Auto"/><!-- actions -->
            </Grid.RowDefinitions>

            <!-- source picker -->
            <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="StudioPathBox" IsReadOnly="True" VerticalContentAlignment="Center"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="StudioBrowseBtn" Content="Browse…" Margin="8,0,0,0" Click="StudioBrowse_Click"/>
                    <Button Grid.Column="2" x:Name="StudioOpenBtn" Content="OPEN IN STUDIO" Margin="8,0,0,0" Click="StudioOpen_Click"/>
                </Grid>
            </Border>

            <!-- status -->
            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock x:Name="StudioStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="Open a franchise save to edit a COPY of it. Your original files are never overwritten."/>
                </StackPanel>
            </Border>

            <!-- teams + season -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Grid.Row="0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}">
                    <Run Text="▪ "/><Run Text="Season year:"/></TextBlock>
                    <TextBox x:Name="SeasonYearBox" Width="70" Margin="8,0,0,0" VerticalContentAlignment="Center"/>
                    <Button x:Name="ApplySeasonBtn" Content="Set Season Year" Margin="8,0,0,0" Click="ApplySeason_Click"/>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="TeamGrid" AutoGenerateColumns="False" IsReadOnly="False"
                          HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName, Mode=TwoWay}" Width="*"/>
                        <DataGridTextColumn Header="Nick Name" Binding="{Binding NickName, Mode=TwoWay}" Width="*"/>
                        <DataGridTextColumn Header="Asset Name (key)" Binding="{Binding AssetName}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="StudioSaveBtn" Content="SAVE CHANGED COPY" Padding="20,8" Click="StudioSave_Click" IsEnabled="False"/>
                <TextBlock x:Name="StudioNote" VerticalAlignment="Center" Margin="14,0,0,0"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="480"/>
            </StackPanel>
        </Grid>
            </TabItem>
            <TabItem Header="SETTINGS">
        <Grid Margin="0,12,0,0">
            <StackPanel>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="14">
                    <StackPanel>
                        <TextBlock Grid.Row="0" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10">
                            <Run Text="▪ "/><Run Text="SETTINGS"/></TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
            </TabItem>
        </TabControl>

        <!-- music ribbon -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="4" Margin="0,12,0,0" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0">
                    <Run Text="♪ BGM"/></TextBlock>
                <Button Grid.Column="1" x:Name="BgmToggleBtn" Content="▶ Play" Padding="10,5" Click="BgmToggle_Click"/>
                <Button Grid.Column="2" x:Name="BgmSkipBtn" Content="⏭ Skip" Padding="10,5" Margin="8,0,0,0"
                        Click="BgmSkip_Click" HorizontalAlignment="Left"/>
                <TextBlock Grid.Column="3" x:Name="BgmNow" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" Text="no music tracks"
                           FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
            </Grid>
        </Border>
    </Grid>
</Window>
