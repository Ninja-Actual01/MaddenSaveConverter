<Window x:Class="MaddenSaveConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="Legion of Loom Football Game Tool" Height="640" Width="780"
        Background="{StaticResource BgBrush}" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- banner -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="Assets/logo.png" Height="72" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="LEGION OF LOOM" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="FOOTBALL GAME TOOL" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="2,2,0,0"/>
                <TextBlock Text="madden · college · rosters · draft classes · franchise files" FontSize="11"
                           Foreground="{StaticResource MutedBrush}" Margin="2,4,0,0"/>
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="CONVERT">
        <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- source picker -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="14">
            <StackPanel>
                <TextBlock Text="SOURCE SAVE FILE" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SourcePathBox" Grid.Column="0" IsReadOnly="True"
                             TextChanged="SourcePath_TextChanged" VerticalContentAlignment="Center"/>
                    <Button x:Name="BrowseBtn" Grid.Column="1" Content="Browse…" Margin="10,0,0,0" Click="Browse_Click"/>
                </Grid>

                <Border x:Name="DetectPanel" Background="#00C04814" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DetectIcon" Text="▶" Foreground="{StaticResource AccentBrush}"
                                   FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock x:Name="DetectText" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- convert -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="ConvertBtn" Content="CONVERT" Padding="28,9" Click="Convert_Click" IsEnabled="False"/>
            <TextBlock x:Name="OutputNote" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="520"/>
        </StackPanel>

        <!-- log -->
        <Border Grid.Row="3" Background="#060606" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="4" Margin="0,14,0,0">
            <TextBox x:Name="LogBox" Background="Transparent" Foreground="#9FE0B4"
                     FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0" Padding="8"/>
        </Border>
    </Grid>
            </TabItem>
            <TabItem Header="FRANCHISE STUDIO">
        <Grid Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><!-- source -->
                <RowDefinition Height="Auto"/><!-- status -->
                <RowDefinition Height="*"/><!-- teams / season -->
                <RowDefinition Height="Auto"/><!-- actions -->
            </Grid.RowDefinitions>

            <!-- source picker -->
            <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="StudioPathBox" IsReadOnly="True" VerticalContentAlignment="Center"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="StudioBrowseBtn" Content="Browse…" Margin="8,0,0,0" Click="StudioBrowse_Click"/>
                    <Button Grid.Column="2" x:Name="StudioOpenBtn" Content="OPEN IN STUDIO" Margin="8,0,0,0" Click="StudioOpen_Click"/>
                </Grid>
            </Border>

            <!-- status -->
            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock x:Name="StudioStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="Open a franchise save to edit a COPY of it. Your original files are never overwritten."/>
                </StackPanel>
            </Border>

            <!-- teams + season -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Season year:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="SeasonYearBox" Width="70" Margin="8,0,0,0" VerticalContentAlignment="Center"/>
                    <Button x:Name="ApplySeasonBtn" Content="Set Season Year" Margin="8,0,0,0" Click="ApplySeason_Click"/>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="TeamGrid" AutoGenerateColumns="False" IsReadOnly="False"
                          HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                          Background="#060606" Foreground="{StaticResource TextBrush}"
                          AlternatingRowBackground="#0D0D0D" RowBackground="#080808"
                          BorderBrush="{StaticResource PanelBorderBrush}" GridLinesVisibility="None"
                          HorizontalGridLinesBrush="#1E3D28" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName, Mode=TwoWay}" Width="*"/>
                        <DataGridTextColumn Header="Nick Name" Binding="{Binding NickName, Mode=TwoWay}" Width="*"/>
                        <DataGridTextColumn Header="Asset Name (key)" Binding="{Binding AssetName}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="StudioSaveBtn" Content="SAVE CHANGED COPY" Padding="20,8" Click="StudioSave_Click" IsEnabled="False"/>
                <TextBlock x:Name="StudioNote" VerticalAlignment="Center" Margin="14,0,0,0"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="480"/>
            </StackPanel>
        </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
