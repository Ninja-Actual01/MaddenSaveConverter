<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyTitle>Madden Save Converter</AssemblyTitle>
    <Product>Madden Save Converter</Product>
    <Version>1.2.4</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="convert_franchise_m26_to_m27.mjs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Boot-up sting -->
  <ItemGroup>
    <Content Include="Sounds\*.mp3" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- BGM playlist manifest (and any user audio dropped in Music) -->
  <ItemGroup>
    <Content Include="Music\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Music\*.mp3" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Music\*.wav" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Music\*.m4a" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Franchise Studio: ship the Node engine (engine + its vendored pure-JS deps)
       so the portable folder is self-contained. Decompression uses Node's built-in
       zlib zstd, so no native modules are needed. -->
  <ItemGroup>
    <Content Include="FranchiseEngine\engine.mjs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="FranchiseEngine\README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="package.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="node_modules\**\*" CopyToOutputDirectory="PreserveNewest" Link="node_modules\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
